   "metadata": {},
   "source": [
    "### Rank vs Score plot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "cd46869c-39bb-40a1-9f9e-e6905bcd6c27",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.plot(dataset[\"score\"], dataset[\"Rank\"], marker='o', linestyle='--', color='green')\n",
    "plt.title(\"Rank vs. Score\")\n",
    "plt.xlabel(\"Score\")\n",
    "plt.ylabel(\"Rank\")\n",
    "plt.gca().invert_yaxis()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1cac3cbb-cfda-4804-9e9a-7c546523cfb2",
   "metadata": {},
   "source": [
    "## Score Range"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "d4daeee5-6389-46d6-9894-e377ce5cc37c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "bins = [0, 500, 600, 650, 700, 720]\n",
    "labels = ['0-500', '500-600', '600-650', '650-700', '700-720']\n",
    "dataset['Score Range'] = pd.cut(dataset['score'], bins=bins, labels=labels)\n",
    "\n",
    "score_range_counts = dataset['Score Range'].value_counts(sort=False)\n",
    "\n",
    "score_range_counts.plot(kind='bar', color='orange', edgecolor='black')\n",
    "plt.title(\"Candidates by Score Range\")\n",
    "plt.xlabel(\"Score Range\")\n",
    "plt.ylabel(\"Number of Candidates\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4b9f9b09-5e86-452f-b9df-32fb11e9c253",
   "metadata": {},
   "source": [
    "## Distribution of candidates eligible for top 5 aiims "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "3fb3f87f-8b1a-4d68-845c-ce50dd7ae76c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "eligible1 = (dataset[\"AIIMS Delhi\"] == \"Eligible\").sum()\n",
    "eligible2 = (dataset[\"AIIMS Bhopal\"] == \"Eligible\").sum()\n",
    "eligible3 = (dataset[\"AIIMS Rishikesh\"] == \"Eligible\").sum()\n",
    "eligible4 = (dataset[\"AIIMS Bhubaneshwar\"] == \"Eligible\").sum()\n",
    "eligible5 = (dataset[\"AIIMS Nagpur\"] == \"Eligible\").sum()\n",
    "\n",
    "import seaborn\n",
    "palette_color = seaborn.color_palette('bright')\n",
    "\n",
    "pieData = [eligible1, eligible2, eligible3, eligible4, eligible5]\n",
    "keys = [\"AIIMS Delhi\",\"AIIMS Bhopal\" ,\"AIIMS Rishikesh\" ,\"AIIMS Bhubaneshwar\" ,\"AIIMS Nagpur\"]\n",
    "plt.pie(pieData, labels=keys, colors=palette_color, autopct='%.0f%%') \n",
    "plt.show()\n"
   ]
  },
