   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "dataset = pd.read_csv(\"all_data.csv\")\n",
    "dataset.dropna()\n",
    "dataset.info"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "59d3e8a3-d26c-45de-9765-c29280721f2e",
   "metadata": {},
   "source": [
    "## based on shiksha.com the cutoffs for neet 2024 were calculated based on\n",
    "#### 1. For Unreserved/General - 50th percentile of marks meaning the cutoff range is 720 - 164\n",
    "#### 2. For SC/ST/OBC - 40th percentile of marks meaning the cutoff range is 161 - 127"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "f7166ff3-9ae2-45e0-ac4c-97505e0ee104",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "General cutoff 2024:  163.0\n",
      "Reserved cutoff 2024:  128.0\n"
     ]
    }
   ],
   "source": [
    "# finding cutoff based on given score from the data\n",
    "scores = dataset[\"score\"]\n",
    "\n",
    "general = np.percentile(scores, 50)\n",
    "reserved = np.percentile(scores, 40)\n",
    "\n",
    "print(\"General cutoff 2024: \", general)\n",
    "print(\"Reserved cutoff 2024: \", reserved)"
   ]
  },
