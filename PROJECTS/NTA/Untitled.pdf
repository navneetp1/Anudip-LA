   "source": [
    "# calculating Ranks using the dataset\n",
    "\n",
    "dataset['Rank'] = dataset[\"score\"].rank(ascending=False, method='min').astype(int)\n",
    "dataset = dataset.sort_values(by='Rank').reset_index(drop=True)\n",
    "print(\"Top 15 ranked\")\n",
    "dataset.head(15)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9d5e2ff6-e086-42ee-b822-8ba3563c4462",
   "metadata": {},
   "source": [
    "## checking eligibility for top Medical Colleges, closing ranks\n",
    "### 1. AIIMS Delhi - 47\n",
    "### 2. AIIMS Bhopal - 79\n",
    "### 3. AIIMS Rishikesh - 594\n",
    "### 4. AIIMS Bhubaneshwar - 655\n",
    "### 5. AIIMS Nagpur - 953"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "46258ceb-2f62-4d4f-81d8-0f8915090ea7",
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset['AIIMS Delhi'] = dataset['Rank'].apply(lambda x: 'Eligible' if x < 47 else 'Not Eligible')\n",
    "dataset['AIIMS Bhopal'] = dataset['Rank'].apply(lambda x: 'Eligible' if x < 79 else 'Not Eligible')\n",
    "dataset['AIIMS Rishikesh'] = dataset['Rank'].apply(lambda x: 'Eligible' if x < 594 else 'Not Eligible')\n",
    "dataset['AIIMS Bhubaneshwar'] = dataset['Rank'].apply(lambda x: 'Eligible' if x < 655 else 'Not Eligible')\n",
    "dataset['AIIMS Nagpur'] = dataset['Rank'].apply(lambda x: 'Eligible' if x < 953 else 'Not Eligible')\n",
    "\n",
    "dataset.iloc[150:350]"
   ]
  },
